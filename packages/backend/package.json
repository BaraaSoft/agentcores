{
  "name": "@ahe/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "validate": "pnpm typecheck",
    "test": "jest --passWithNoTests",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://ahe:ahe@localhost:5433/ahe_test} jest integration",
    "test:smoke": "jest --config test/jest-smoke.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "eval:self-review": "ts-node scripts/eval-self-review.ts"
  },
  "dependencies": {
    "@ahe/agent-core": "workspace:*",
    "@ahe/execution": "workspace:*",
    "@anthropic-ai/sdk": "^0.133.0",
    "@bull-board/api": "^6.20.7",
    "@bull-board/express": "^6.20.7",
    "@bull-board/nestjs": "^6.20.7",
    "@huggingface/transformers": "^4.3.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "bullmq": "^5.67.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express-basic-auth": "^1.2.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
