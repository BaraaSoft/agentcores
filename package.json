{
  "name": "cipher-ahe",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter @ahe/agent-core --filter @ahe/execution build",
    "dev:backend": "pnpm build:libs && pnpm --filter @ahe/backend start:dev",
    "dev:reset": "bash scripts/reset-dev.sh",
    "quickstart": "bash scripts/quickstart.sh",
    "eval": "pnpm build:libs && pnpm --filter @ahe/backend eval:self-review",
    "dev:start": "concurrently --kill-others --names backend,web --prefix-colors \"#0081FB.bold,#4CB782.bold\" \"pnpm dev:backend\" \"wait-on --timeout 180000 tcp:localhost:3088 && pnpm dev:web\"",
    "dev:web": "pnpm --filter @ahe/web-ui dev",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @ahe/backend test:integration",
    "test:smoke": "pnpm build:libs && pnpm --filter @ahe/backend test:smoke",
    "compose:up": "docker compose -f compose.yaml up --build",
    "compose:down": "docker compose -f compose.yaml down",
    "migrate": "pnpm --filter @ahe/migrations migrate",
    "migrate:sync": "pnpm --filter @ahe/migrations migrate:sync",
    "migration:check": "pnpm --filter @ahe/migrations migration:check",
    "migration:generate": "pnpm --filter @ahe/migrations migration:generate:main",
    "migration:revert": "pnpm --filter @ahe/migrations migration:revert:main"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "wait-on": "^9.5.1"
  }
}