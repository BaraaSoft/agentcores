# ── Server ──
PORT=3088
NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ahe@local

# ── Database (Postgres + pgvector) ──
DATABASE_URL=postgres://ahe:ahe@localhost:5433/ahe

# ── Queue (Redis for BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6380

# ── Model API keys ──
# Set the key of each provider you pick below, and leave the other key empty.
# [required if any provider below is anthropic]
ANTHROPIC_API_KEY=
# [required if any provider below is muse] Create one at https://dev.meta.ai/docs/authentication
META_API_KEY=

# ── Reasoning (planning and judgement) ──
# [optional] *_PROVIDER: anthropic or muse. Default: anthropic.
# [optional] *_MODEL_ID: leave empty for the provider's default, claude-opus-5-5 or muse-wonder-1.0.
#            muse-spark-1.3 is the faster Muse model, for example for REASONING_TASK_MODEL_ID.
# Strategy: plans each Unit's Jobs, and also runs the evaluator
REASONING_STRATEGY_PROVIDER=muse
REASONING_STRATEGY_MODEL_ID=
# Job: plans and reviews each Job's Tasks
REASONING_JOB_PROVIDER=muse
REASONING_JOB_MODEL_ID=
# Task: plans every step, the hot path
REASONING_TASK_PROVIDER=muse
REASONING_TASK_MODEL_ID=

# ── Execution (computer use on the Mac Mini display) ──
# [optional] anthropic or muse. Default: anthropic. Anthropic runs Claude with its built-in computer tool,
# and is the most reliable on screen. Muse runs Meta's model through our own computer tools, so a judge
# with only META_API_KEY can run everything.
EXECUTION_PROVIDER=anthropic
# [optional] Leave empty for the default: claude-sonnet-5-5 or muse-wonder-1.0.
# Anthropic needs a model with computer_toolset_20260801, e.g. claude-haiku-5-5. Muse: use muse-wonder-1.0;
# muse-spark-1.3 often stops early on screen tasks.
EXECUTION_MODEL_ID=
# [optional] Largest screenshot sent to the model. Default: 1280 x 800. The display is scaled down to fit,
# keeping its aspect ratio.
SCREENSHOT_MAX_WIDTH=1280
SCREENSHOT_MAX_HEIGHT=800

# ── HumanExperiences.IO memory bridge ── [optional, leave as is]
# [required, keep as is] The backend does not start without both lines, but the bridge is not built yet,
# so nothing calls it. Leave the URL and the empty key unchanged.
HE_MEMORY_URL=http://localhost:3077/api
HE_MEMORY_API_KEY=
