# ── Server ──
PORT=3088
NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ahe@local

# ── Database (Postgres + pgvector) ──
DATABASE_URL=postgres://ahe:ahe@localhost:5433/ahe

# ── Queue (Redis for BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6380

# ── Model API keys ──
# Each reasoning level and EXECUTION_PROVIDER uses the key of the provider it names. Set only the keys in use.
ANTHROPIC_API_KEY=
# Meta Model API key, for the muse provider
META_API_KEY=

# ── Reasoning (planning and judgement) ──
# Each level picks a provider: anthropic (default) or muse. The model id is optional; when empty, the
# provider's default runs: anthropic uses claude-opus-5-5 everywhere; muse uses muse-wonder-1.0
# everywhere. muse-spark-1.3 is the faster Muse model, for example for REASONING_TASK_MODEL_ID.
# Strategy: plans each Unit's Jobs, and also runs the evaluator
REASONING_STRATEGY_PROVIDER=anthropic
REASONING_STRATEGY_MODEL_ID=
# Job: plans and reviews each Job's Tasks
REASONING_JOB_PROVIDER=anthropic
REASONING_JOB_MODEL_ID=
# Task: plans every step, the hot path
REASONING_TASK_PROVIDER=anthropic
REASONING_TASK_MODEL_ID=

# ── Execution (computer use on the Mac Mini display) ──
# Provider: anthropic (default) or muse. Anthropic runs Claude with its built-in computer tool; muse runs
# Meta's model through our own computer tools, so a judge with only META_API_KEY can run everything.
EXECUTION_PROVIDER=anthropic
# Optional; when empty, anthropic uses claude-sonnet-5-5 and muse uses muse-wonder-1.0.
# Anthropic needs a model with computer_toolset_20260801, e.g. claude-haiku-5-5. Muse: use muse-wonder-1.0;
# muse-spark-1.3 often stops early on screen tasks.
EXECUTION_MODEL_ID=
# Largest screenshot sent to the model; the display is scaled down to fit, keeping its aspect ratio
SCREENSHOT_MAX_WIDTH=1280
SCREENSHOT_MAX_HEIGHT=800
EXECUTION_MAX_STEPS=70

# ── HumanExperiences memory bridge ──
HE_MEMORY_URL=http://localhost:3077/api
HE_MEMORY_API_KEY=
